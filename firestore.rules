rules_version = '2';
// ALL data access goes through the backend (Firebase Admin SDK bypasses these rules).
// Browsers get no direct read/write access to any collection, so a leaked web config
// or a stolen ID token cannot read CVs, jobs, drafts or integration secrets directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
