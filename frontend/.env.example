# Public web config only. NEVER put secrets in VITE_ variables: they are shipped to the browser.
VITE_API_BASE_URL=http://localhost:8080
# true = no Firebase login; talks to a backend running with AUTH_MODE=demo (local development only)
VITE_DEMO_MODE=true

# Firebase Web App config (Project settings > Your apps). These values are public identifiers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
