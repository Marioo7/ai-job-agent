    "pdfjs-dist": "4.10.38",
    "telegram": "^2.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0"
