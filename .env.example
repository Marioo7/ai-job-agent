# ===== Backend + Worker configuration (placeholders only; never commit a real .env) =====
# Default values below run the whole app locally in DEMO mode with no accounts or credentials.

NODE_ENV=development
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth ---
# demo     = no login, anyone reaching the backend is "demo-user". Local development only (refused in production).
# firebase = verify Firebase ID tokens (required for real use).
AUTH_MODE=demo
# Comma-separated Google/Firebase emails allowed to use the app (single-user app). REQUIRED when AUTH_MODE=firebase.
ALLOWED_EMAILS=

# --- Database & files ---
# memory = in-process, wiped on restart (demo). firestore = real persistence (requires Firebase credentials below).
DB_MODE=memory
# local = private folder on the backend's disk (needs a persistent disk).
# firestore = CV files stored inside Firestore (works on the FREE Firebase plan and on hosts with an ephemeral disk).
# firebase = private Cloud Storage bucket (Cloud Storage for Firebase needs a billing account since Feb 2026).
STORAGE_MODE=local
STORAGE_DIR=.data/files

# --- Firebase Admin (server-side only) ---
FIREBASE_PROJECT_ID=
# Path to the service-account JSON file (keep it OUTSIDE the repo), or paste the JSON in FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# --- Secrets encryption (Telegram session, Gmail refresh token). Generate: npm run gen:key ---
SECRETS_ENCRYPTION_KEY=

# --- AI (optional) ---  none | mock | gemini | openai-compatible
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_INPUT_CHARS=6000
AI_DAILY_CALL_CAP=200

# --- Gmail ---  mock (simulated sends) | google (real OAuth)
GMAIL_MODE=mariofathy18@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/gmail/callback

# --- Automatic applying (OPTIONAL, server-level master switch) ---
# false (default) = the UI cannot enable automatic sending at all; everything stays manual (approve + press send).
# true  = you MAY switch "Automatic" on in Preferences. Needs OWNER_UID. Still off until you do it in the UI.
ALLOW_AUTO_APPLY=false
AUTO_APPLY_INTERVAL_SEC=60

# --- Telegram worker ---  mock (demo posts only) | real (GramJS, your own account)
TELEGRAM_MODE=mock
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Your Firebase user id (shown on the Integrations page). The worker acts only for this user.
OWNER_UID=demo-user
MOCK_MESSAGE_INTERVAL_SEC=45
# How often the worker re-reads EVERY source (in addition to the live stream) so nothing is missed. Default 300 = 5 min.
TELEGRAM_POLL_INTERVAL_SEC=300
WORKER_TICK_SEC=20
# Free-hosting setup: run the Telegram worker inside the backend process (ONE service). Never also run a separate worker.
RUN_WORKER_IN_BACKEND=false
# Worker is shown as offline when its heartbeat is older than this (use 180 when WORKER_TICK_SEC=60).
WORKER_OFFLINE_AFTER_SEC=90
